<mxfile host="app.diagrams.net" agent="ttokttok-erd-gen" version="24.7.0"><diagram id="all" name="전체 ERD"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="all-1" value="&lt;font style=&quot;font-size:26px&quot;&gt;&lt;b&gt;똑똑 Phase1 MVP — ERD&lt;/b&gt;&lt;/font&gt;  &lt;font color=&quot;#64748B&quot;&gt;PostgreSQL · Flyway V1~V9 · 39 테이블 · 2026-10-07&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="0" y="-150" width="1400" height="40" as="geometry"/></mxCell><mxCell id="all-2" value="&lt;b&gt;범례&lt;/b&gt;&lt;br&gt;PK 기본키 · FK 외래키(제약 있음) · UK 유니크 · &lt;font color=&quot;#94A3B8&quot;&gt;(FK)&lt;/font&gt; 논리 참조(제약 없음)&lt;br&gt;타입 뒤 &lt;b&gt;?&lt;/b&gt; = null 허용 · &lt;font color=&quot;#16A34A&quot;&gt;+V6&lt;/font&gt; = 나중 마이그레이션에서 추가된 컬럼 · 헤더의 V# = 테이블 생성 마이그레이션&lt;br&gt;관계선: 참조되는 쪽 ┼ (1), 참조하는 쪽 ≺ 다수 / ○≺ 0..다수 / ○┼ 0..1&lt;br&gt;공통 규칙: PK 는 UUID v7(앱 생성), 연락처·생년월일은 AES-256-GCM 암호문(*_enc) + 조회용 HMAC(*_hash), 기관 범위 테이블은 institution_id 필수&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;이 페이지는 가독성을 위해 institution_id → institution 관계선을 생략했다 (영역별 페이지에 표시).&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="0" y="-104" width="1500" height="90" as="geometry"/></mxCell><mxCell id="all-3" value="기관 · 사용자 · 인증" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#E8EAF3;strokeColor=#1B2559;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=16;fontStyle=1;fontColor=#1B2559;container=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="802" height="1134" as="geometry"/></mxCell><mxCell id="all-4" value="&lt;b&gt;institution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#FFFFFFCC&quot;&gt;기관 ·